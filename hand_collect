            if not show_preview:
                cv2.destroyWindow("Segmented Preview (240x240 of 96x96)")
            print("미리보기: {}".format("ON" if show_preview else "OFF"))

finally:
    running = False
    cap.release()
    cv2.destroyAllWindows()
    sock_tx.close()
    trigger_thread.join(timeout=1.0)

    print("\n=== 수집 완료 ===")
    for cls in CLASS_NAMES:
        print("  {:10s}: {:3d} 장".format(cls, counts[cls]))

